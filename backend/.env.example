# Port the API/frontend server listens on
PORT=3000

# --- Google Sheets (data source) ---
# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=

# Path to a Google service-account JSON key file with view access to the sheet
# (share the spreadsheet with the service account's client_email as Viewer).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternative: paste the whole service-account JSON as one line instead of using a file.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Outgoing mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- TAT deadline alert emails (replaces the Apps Script time trigger) ---
ALERT_RECIPIENTS=vikramadhithyabioinformatics@gmail.com
DASHBOARD_URL=http://localhost:3000/
# Cron expression, evaluated in TZ below. Default: every day at 09:00.
TAT_ALERT_CRON=0 9 * * *
TZ=Asia/Kolkata
# Set to "false" to disable the daily TAT alert job entirely.
ENABLE_TAT_ALERTS=true

# --- CORS ---
# Only needed if the frontend is hosted on a different origin than this API.
# Comma-separated list of allowed origins, or "*" for any.
CORS_ORIGIN=*
